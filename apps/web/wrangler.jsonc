{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starter-web",
  "compatibility_date": "2026-07-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "starter.sztadii.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
